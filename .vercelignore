# Vercel CLI does not follow .gitignore. List every heavy directory
# explicitly. None of these are needed by either Vercel project's Next.js
# build (the main app under /app, or packages/rpd-whale-web).

# Build artifacts
node_modules
.next
.turbo
**/node_modules
**/.next
**/.turbo
**/dist
*.tsbuildinfo

# Sibling packages — none are imported by either Next.js app.
# Only /packages/zkrune-sdk is imported (by lib/clientZkProof.ts).
/packages/zkrune-mobile/
/packages/zkrune-telegram-bot/
/packages/zkrune-widget/
/packages/zkrune-cli/
/packages/kage-plugin/
/packages/x402-verify/

# Smart-contract / non-Next.js subprojects
/solana-staking-program/
/solana-groth16-verifier/
/sui-groth16-verifier/
/evm-verifier/
**/.anchor
**/target

# Circuit *source* files at the repo root.
# Leading slash anchors to root — bare `circuits` / `ceremony` would
# also strip public/circuits/ and app/ceremony/, breaking the verifier
# and the ceremony route.
/circuits/
/ceremony/

# QA / test outputs
coverage
test-results
playwright-report
__tests__
e2e

# Vercel / git metadata
.vercel
.git

# Misc local. Anchored to root so app/docs/ (Fumadocs route) and
# content/docs/ (MDX content) remain in the deployment.
/business/
/docs/

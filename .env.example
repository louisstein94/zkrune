# Solana Network (devnet, testnet, mainnet-beta)
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# zkRUNE Token Mint Address
# Devnet: A619D39h4CxHT7rSSurWAb2Un36c6W8BLyJWBYGxzstP
# Mainnet: 51mxznNWNBHh6iZWwNHBokoaxHYS2Amds1hhLGXkpump
NEXT_PUBLIC_ZKRUNE_MINT=A619D39h4CxHT7rSSurWAb2Un36c6W8BLyJWBYGxzstP

# Staking Program ID
NEXT_PUBLIC_STAKING_PROGRAM_ID=44ToPJzWsnqJRhvFS5wXLsgWGWpbe3YwhU9t8LkQBRiX

# Groth16 Verifier Program
NEXT_PUBLIC_GROTH16_VERIFIER_PROGRAM=9apA5U8YywgTHXQqpbvUMHJej7yorHcN56cewKfkX7ad

# ─── Solana RPC (Helius is the default provider) ──────────────────────────
# Helius serves every server-side Solana call: proof verification, balance
# attestation, the RPC proxy and the snapshot scripts. Without a credential
# the app falls back to the public mainnet endpoint, which rate-limits hard
# and blocks getProgramAccounts. Free key at helius.dev.
#
# Set EITHER of the following — HELIUS_RPC_URL wins if both are present.
HELIUS_API_KEY=your_helius_api_key_here
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here
#
# Optional explicit override, used only when no Helius credential is set.
# Must point at mainnet — these paths read mainnet token balances.
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Whale Chat — Telegram invite link (keep out of source code)
NEXT_PUBLIC_WHALE_CHAT_LINK=https://t.me/+your_invite_hash_here

# Supabase (required for Governance + Marketplace)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon key — used ONLY by client-side code (browser). Safe to expose publicly.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Service role key — used by server-side API routes. NEVER expose to the browser.
# All /app/api/*/route.ts files authenticate with this key via lib/supabase/serverClient.ts.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Platform treasury wallet (receives operational reserve from marketplace fees)
NEXT_PUBLIC_TREASURY_ADDRESS=your_treasury_wallet_address

# Staking reward vault — token account that funds staker rewards.
# Marketplace platform fees are routed here (controlled by REWARD_POOL_SHARE in config).
NEXT_PUBLIC_REWARD_VAULT_ADDRESS=your_reward_vault_token_account

# Balance Attestation Secret — used to sign on-chain balance attestations.
# REQUIRED in production — the /api/balance-attestation route fails closed
# when unset. Generate with: openssl rand -hex 32
ATTESTATION_SECRET=your_attestation_secret_here

# Ceremony Admin Token — gates POST /api/ceremony, /api/ceremony/sync,
# /api/ceremony/zkey. Without this token, those endpoints return 503.
# Clients authenticate with: Authorization: Bearer <token>
# Generate with: openssl rand -hex 32
CEREMONY_ADMIN_TOKEN=your_ceremony_admin_token_here

# zkBlink AI — set ONE of the keys below (required for /zkblink)
# Anthropic key takes priority when both are present.
#
# Anthropic (recommended) — https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
#
# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here
#
# Optional: override default model
# Anthropic default: claude-sonnet-4-20250514 | OpenAI default: gpt-4o-mini
# AI_MODEL=claude-sonnet-4-20250514

# EVM / Base (Groth16 verifier — used by the live on-chain demos)
# NEXT_PUBLIC_EVM_VERIFIER_ADDRESS=0xa03A353d890033aC9b3044776440C2a4c9E849EA
# Optional private RPC. Without it, browser demos fall back across public Base
# endpoints (publicnode/drpc/mainnet.base.org). Set this to avoid public
# rate-limits surfacing as "HTTP request failed" in the UI.
# NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your_key

# Sui (Groth16 verifier — after npm run sui:deploy:devnet + sui:register:devnet)
# NEXT_PUBLIC_SUI_NETWORK=devnet
# NEXT_PUBLIC_SUI_RPC_URL=https://fullnode.devnet.sui.io:443
# NEXT_PUBLIC_SUI_GROTH16_PACKAGE=0x...
# NEXT_PUBLIC_SUI_VERIFIER_REGISTRY=0x...
# Optional: script-only IDs (same values as above without NEXT_PUBLIC_)
# SUI_PACKAGE_ID=0x...
# SUI_VERIFIER_REGISTRY_ID=0x...
# SUI_ADMIN_CAP_ID=0x...
# SUI_PRIVATE_KEY=... 64 hex or suiprivkey1… from `sui keytool export`
# SUI_KEYSTORE_PATH=/path/to/sui_keystore  if not ~/.sui/sui_keystore
# SUI_SIGNER_ADDRESS=0x...  optional; if keystore has several keys, pin the AdminCap owner

# Faucet Private Key (base58 or JSON array, only for devnet admin)
# FAUCET_PRIVATE_KEY=[...]

# ─── RWA eligibility demo (optional) ──────────────────────────────────────
# The /rwa demo verifies its proof against the Groth16 verifier on devnet.
# Without these it still runs and reports a locally verified proof, it just
# skips the chain step rather than failing.
#
# Devnet program carrying the rwa-eligibility verification key (template 13).
# NEXT_PUBLIC_RWA_VERIFIER_PROGRAM_DEVNET=
#
# Devnet keypair that pays for the verification transaction, as a JSON array.
# Devnet SOL only — this key must never hold anything of value.
# DEVNET_DEMO_PAYER_KEY=[1,2,3,...]
